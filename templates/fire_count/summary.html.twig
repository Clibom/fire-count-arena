{% extends 'base.html.twig' %}

{% block title %}{{ 'fire_count.summary.title'|trans }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200 flex items-center justify-center p-4">
    <div class="card w-full max-w-lg bg-base-100 shadow-xl">
        <div class="card-body text-center">
            <div class="flex justify-center mb-4">
                <img src="{{ asset('images/logo_hce_256.png') }}" alt="{{ 'app.title'|trans }}" class="w-24 h-24">
            </div>

            <h1 class="text-3xl font-bold text-primary mb-8">
                {{ 'fire_count.summary.title'|trans }}
            </h1>

            {# Large, clear display for emergency responders #}
            <div class="stats stats-vertical lg:stats-horizontal shadow w-full mb-6">
                <div class="stat">
                    <div class="stat-title text-lg">{{ 'fire_count.summary.adults'|trans }}</div>
                    <div class="stat-value text-primary text-5xl">{{ fireCount.adultsCount }}</div>
                </div>

                <div class="stat">
                    <div class="stat-title text-lg">{{ 'fire_count.summary.children'|trans }}</div>
                    <div class="stat-value text-secondary text-5xl">{{ fireCount.childrenCount }}</div>
                </div>
            </div>

            <div class="divider"></div>

            <div class="py-4">
                <div class="text-lg text-base-content/70 mb-2">{{ 'fire_count.summary.total'|trans }}</div>
                <div class="text-6xl font-black text-accent">{{ fireCount.totalPeople }}</div>
            </div>

            <p class="text-base-content/50 text-sm mt-8">
                {{ 'fire_count.summary.submitted_on'|trans({'%date%': fireCount.createdAt|format_datetime('long', 'short')}) }}
            </p>
        </div>
    </div>
</div>
{% endblock %}