<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" type="image/png" sizes="64x64" href="{{ asset('images/logo_hce_64.png') }}">
        <link rel="icon" type="image/png" sizes="128x128" href="{{ asset('images/logo_hce_128.png') }}">
        <link rel="apple-touch-icon" sizes="256x256" href="{{ asset('images/logo_hce_256.png') }}">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
